{
    "name": "gesture-extension",
    "version": "1.1.0",
    "description": "Forum layout plus desktop and mobile gestures for Chromium and Kiwi Browser.",
    "main": "background/service-worker.js",
    "scripts": {
        "build": "node scripts/build.js",
        "build:zip": "npm run build && mkdir -p /Users/best/github/extension && zip -r /Users/best/github/extension/gesture.zip manifest.json background content dist icons shared ui",
        "watch": "node scripts/build.js --watch",
        "test": "node tests/run.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "keywords": [
        "chrome-extension",
        "gestures",
        "manifest-v3"
    ],
    "author": "",
    "license": "MIT",
    "lint-staged": {
        "*.{js,css,html,json,md}": [
            "prettier --write"
        ],
        "*.js": [
            "eslint --fix"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0",
        "prettier": "^3.9.6"
    }
}
